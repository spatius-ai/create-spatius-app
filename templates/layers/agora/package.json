{
  "name": "spatius-agora-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --kill-others vite \"tsx watch --env-file-if-exists=.env.local server/index.ts\"",
    "start": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@spatius/avatarkit": "1.3.8",
    "@spatius/avatarkit-rtc": "1.1.5",
    "agora-token": "2.0.6",
    "agora-rtc-sdk-ng": "4.24.8",
    "agora-rtm-sdk": "2.3.0",
    "agora-agent-client-toolkit": "2.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "typescript": "6.0.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@webgpu/types": "0.1.72",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "typescript-eslint": "8.69.0",
    "prettier": "3.9.6",
    "vitest": "4.1.11",
    "concurrently": "10.0.5",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1"
  }
}
