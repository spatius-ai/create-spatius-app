{
  "name": "spatius-agora-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "wrangler types --strict-vars=false --env-interface CloudflareBindings && tsc -b && vite build",
    "typecheck": "wrangler types --strict-vars=false --env-interface CloudflareBindings && tsc -b --pretty false",
    "test": "vitest run",
    "lint": "wrangler types --strict-vars=false --env-interface CloudflareBindings && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:worker",
    "cf-typegen": "wrangler types --strict-vars=false --env-interface CloudflareBindings",
    "deploy": "npm run build && wrangler deploy",
    "wrangler": "wrangler",
    "test:worker": "node scripts/check-worker.mjs",
    "postinstall": "wrangler types --strict-vars=false --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@spatius/avatarkit": "1.3.8",
    "@spatius/avatarkit-rtc": "1.1.5",
    "agora-token": "2.0.6",
    "agora-rtc-sdk-ng": "4.24.8",
    "agora-rtm-sdk": "2.3.0",
    "agora-agent-client-toolkit": "2.9.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "typescript": "6.0.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.72",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "typescript-eslint": "8.69.0",
    "prettier": "3.9.6",
    "vitest": "5.0.0",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.1",
    "@cloudflare/vite-plugin": "1.54.6",
    "wrangler": "4.130.0",
    "miniflare": "5.20260908.0-alpha"
  },
  "packageManager": "pnpm@12.4.1"
}
