{
  "name": "spatius-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:check": "node scripts/run-agent-python.mjs -m src.agent --help && node scripts/run-agent-python.mjs -m unittest discover -s tests && node scripts/run-agent-python.mjs -m ruff check . && node scripts/run-agent-python.mjs -m ruff format --check .",
    "agent:dev": "node scripts/dev-agent.mjs",
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:dev && pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "node scripts/dev.mjs \"pnpm run dev:web\" \"pnpm run agent:dev\"",
    "dev:web": "node scripts/dev-web.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:dev": "node --test tests/dev*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "wrangler": "wrangler"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@livekit/components-react": "2.9.24",
    "@spatius/avatarkit": "1.3.8",
    "@spatius/avatarkit-rtc": "1.1.5",
    "livekit-client": "2.22.2",
    "livekit-server-sdk": "2.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@cloudflare/vite-plugin": "1.54.4",
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/dom-mediacapture-record": "1.0.22",
    "@types/node": "26.4.1",
    "@webgpu/types": "0.1.72",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  }
}
