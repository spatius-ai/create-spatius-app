{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spatius-voice-agent",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CARTESIA_VOICE_ID": "9626c31c-bec5-4cca-baa8-f8ba9e84c8bc",
    "LIVEKIT_URL": "wss://your-project.livekit.cloud",
    "LIVEKIT_AGENT_NAME": "spatius-agent",
    "SPATIUS_APP_ID": "your-spatius-app-id",
    "SPATIUS_AVATAR_ID": "your-spatius-avatar-id",
    "SPATIUS_AVATAR_BACKGROUND_URL": "",
  },
  "secrets": {
    "required": ["LIVEKIT_API_KEY", "LIVEKIT_API_SECRET"],
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
}
